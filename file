<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>My Money Tracker</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--tx:#1b1f24;--mu:#6b7480;--bd:#e2e6ea;--in:#16a34a;--ex:#dc2626;--ac:#4f46e5;--sv:#0891b2;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#14161a;--card:#1d2026;--tx:#eceff3;--mu:#98a1ad;--bd:#2c313a;--in:#4ade80;--ex:#f87171;--ac:#818cf8;--sv:#22d3ee;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#14161a;--card:#1d2026;--tx:#eceff3;--mu:#98a1ad;--bd:#2c313a;--in:#4ade80;--ex:#f87171;--ac:#818cf8;--sv:#22d3ee;color-scheme:dark}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:760px;margin:0 auto;padding:16px}
h1{font-size:20px;margin:4px 0 14px}h2{font-size:16px;margin:0 0 10px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px;margin-bottom:14px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:12px}
.stat small{color:var(--mu);display:block}.stat b{font-size:17px;word-break:break-word}
.bal{grid-column:1/-1}.bal b{font-size:26px}
.in{color:var(--in)}.ex{color:var(--ex)}
form{display:grid;grid-template-columns:1fr 1fr;gap:10px}
form .full{grid-column:1/-1}
label{font-size:12px;color:var(--mu);display:block;margin-bottom:3px}
input,select,button{font:inherit;width:100%;padding:10px;border-radius:10px;border:1px solid var(--bd);background:var(--bg);color:var(--tx)}
button{cursor:pointer;background:var(--ac);color:#fff;border:0;font-weight:600}
button.ghost{background:transparent;color:var(--tx);border:1px solid var(--bd)}
.seg{display:flex;gap:8px}.seg button{background:var(--bg);color:var(--tx);border:1px solid var(--bd)}
.seg button.on.i{background:var(--in);color:#fff;border-color:var(--in)}.seg button.on.e{background:var(--ex);color:#fff;border-color:var(--ex)}
.empty{color:var(--mu);text-align:center;padding:18px 8px;font-size:14px}
.tx{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid var(--bd)}
.tx:first-child{border-top:0}.tx small{color:var(--mu);display:block}
.tx .r{text-align:right;white-space:nowrap}
.tx .a{display:flex;gap:6px;margin-top:4px;justify-content:flex-end}
.tx .a button{width:auto;padding:3px 10px;font-size:12px}
.row{display:flex;align-items:center;gap:8px;margin:7px 0;font-size:13px}
.row .n{width:96px;flex:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .t{flex:1;background:var(--bg);border-radius:6px;height:14px;overflow:hidden}
.row .t i{display:block;height:100%;border-radius:6px}
.row .v{width:104px;text-align:right;flex:none}
.scroll{overflow-x:auto}
.lg{display:flex;gap:14px;font-size:12px;color:var(--mu);margin-bottom:6px;flex-wrap:wrap}
.lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:4px}
.top{display:flex;justify-content:space-between;align-items:center}
.top button{width:auto;padding:6px 12px;font-size:12px}
svg text{fill:var(--mu);font-size:10px}
</style></head><body><main>
<div class="top"><h1>My Money Tracker</h1><button class="ghost" id="clr">Clear all data</button></div>

<div class="grid">
 <div class="stat bal"><small>Total balance</small><b id="bal"></b></div>
 <div class="stat"><small>Total income</small><b class="in" id="inc"></b></div>
 <div class="stat"><small>Total expenses</small><b class="ex" id="exp"></b></div>
 <div class="stat"><small>Transactions</small><b id="cnt"></b></div>
</div>

<div class="card" style="margin-top:14px">
 <h2 id="ft">Add a transaction</h2>
 <form id="f" autocomplete="off">
  <div class="full seg"><button type="button" data-t="income" class="i">Income</button><button type="button" data-t="expense" class="e on">Expense</button></div>
  <div><label for="amt">Amount (₹)</label><input id="amt" type="number" inputmode="decimal" min="0.01" step="0.01" required placeholder="Enter amount"></div>
  <div><label for="date">Date</label><input id="date" type="date" required></div>
  <div class="full"><label for="cat">Category</label><select id="cat"></select></div>
  <div class="full"><label for="desc">Description</label><input id="desc" maxlength="120" required placeholder="What was this for?"></div>
  <div><button type="submit" id="sub">Add transaction</button></div>
  <div><button type="button" class="ghost" id="cancel" style="display:none">Cancel edit</button></div>
 </form>
</div>

<div class="card"><h2>Income vs expenses</h2><div id="c1"></div></div>
<div class="card"><h2>Expenses by category</h2><div id="c2"></div></div>
<div class="card"><h2>Monthly income and expenses</h2><div id="c3"></div></div>
<div class="card"><h2>Monthly savings (income − expenses)</h2><div id="c4"></div></div>

<div class="card"><div class="top"><h2>Transaction history</h2>
 <select id="flt" style="width:auto"><option value="all">All</option><option value="income">Income</option><option value="expense">Expenses</option></select></div>
 <div id="hist"></div></div>
</main>
<script>
const KEY='money_tracker_tx_v1';
const CATS={income:['Salary','Business','Freelance','Investments','Gift','Other'],expense:['Food','Rent','Transport','Shopping','Bills','Health','Entertainment','Education','Other']};
const COL=['#4f46e5','#0891b2','#d97706','#db2777','#16a34a','#7c3aed','#ea580c','#0d9488','#64748b'];
const $=id=>document.getElementById(id);
let tx=[],type='expense',editId=null;
// Single source of truth: tx (amounts stored as integer paise, exactly what the user typed)
function load(){try{const r=JSON.parse(localStorage.getItem(KEY)||'[]');if(Array.isArray(r))tx=r}catch(e){tx=[]}}
function save(){try{localStorage.setItem(KEY,JSON.stringify(tx))}catch(e){}}
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=p=>(p<0?'-':'')+'₹'+(Math.abs(p)/100).toLocaleString('en-IN',{minimumFractionDigits:0,maximumFractionDigits:2});
const sum=(a,t)=>a.filter(x=>x.type===t).reduce((s,x)=>s+x.amt,0);
const mLabel=m=>{const[y,mo]=m.split('-');return new Date(y,mo-1,1).toLocaleString('en-IN',{month:'short',year:'2-digit'})};
const today=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
const empty=m=>'<div class="empty">'+m+'</div>';

function fillCats(sel){$('cat').innerHTML=CATS[type].map(c=>'<option>'+c+'</option>').join('');if(sel)$('cat').value=sel}
function setType(t,sel){type=t;document.querySelectorAll('.seg button').forEach(b=>b.classList.toggle('on',b.dataset.t===t));fillCats(sel)}
document.querySelectorAll('.seg button').forEach(b=>b.onclick=()=>setType(b.dataset.t));

function resetForm(){editId=null;$('f').reset();$('date').value=today();setType('expense');$('ft').textContent='Add a transaction';$('sub').textContent='Add transaction';$('cancel').style.display='none'}
$('cancel').onclick=resetForm;

$('f').onsubmit=e=>{
  e.preventDefault();
  const amt=Math.round(parseFloat($('amt').value)*100);
  if(!(amt>0))return;
  const rec={type,amt,cat:$('cat').value,date:$('date').value,desc:$('desc').value.trim()};
  if(!rec.desc||!rec.date)return;
  if(editId){const i=tx.findIndex(x=>x.id===editId);if(i>-1)tx[i]={...rec,id:editId}}
  else{
    const dup=tx.some(x=>x.type===rec.type&&x.amt===rec.amt&&x.cat===rec.cat&&x.date===rec.date&&x.desc.toLowerCase()===rec.desc.toLowerCase());
    if(dup&&!confirm('An identical transaction already exists. Add it again?'))return;
    tx.push({...rec,id:Date.now().toString(36)+Math.random().toString(36).slice(2,7)});
  }
  save();resetForm();render();
};

function edit(id){const x=tx.find(t=>t.id===id);if(!x)return;editId=id;setType(x.type,x.cat);
  $('amt').value=x.amt/100;$('date').value=x.date;$('desc').value=x.desc;
  $('ft').textContent='Edit transaction';$('sub').textContent='Save changes';$('cancel').style.display='block';
  $('f').scrollIntoView({behavior:'smooth',block:'center'})}
function del(id){if(!confirm('Delete this transaction?'))return;tx=tx.filter(x=>x.id!==id);if(editId===id)resetForm();save();render()}
$('clr').onclick=()=>{if(tx.length&&confirm('Delete ALL your transactions? This cannot be undone.')){tx=[];save();resetForm();render()}};
$('flt').onchange=render;
$('hist').onclick=e=>{const b=e.target.closest('button');if(!b)return;b.dataset.a==='e'?edit(b.dataset.id):del(b.dataset.id)};

function hbars(items,total){
  return items.map(i=>'<div class="row"><span class="n">'+esc(i.l)+'</span><span class="t"><i style="width:'+(total?Math.max(2,i.v/total*100):0)+'%;background:'+i.c+'"></i></span><span class="v">'+fmt(i.v)+(i.p!=null?' · '+i.p+'%':'')+'</span></div>').join('');
}
function vchart(ms,series,signed){
  const W=Math.max(320,ms.length*(series.length*20+24)+30),H=170,pad=18,base=signed?H/2:H-pad;
  const all=series.flatMap(s=>s.d.map(Math.abs)),mx=Math.max(...all,1);
  const scale=(signed?(H/2-pad):(H-2*pad))/mx,gw=(W-20)/ms.length,bw=Math.min(22,(gw-8)/series.length);
  let o='<div class="scroll"><svg width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'"><line x1="0" x2="'+W+'" y1="'+base+'" y2="'+base+'" stroke="var(--bd)"/>';
  ms.forEach((m,i)=>{const x0=10+i*gw+(gw-bw*series.length)/2;
    series.forEach((s,j)=>{const v=s.d[i],h=Math.abs(v)*scale,y=v>=0?base-h:base;
      o+='<rect x="'+(x0+j*bw)+'" y="'+y+'" width="'+(bw-2)+'" height="'+Math.max(h,v?1:0)+'" rx="3" fill="'+(s.cf?s.cf(v):s.c)+'"><title>'+mLabel(m)+': '+fmt(v)+'</title></rect>'});
    o+='<text x="'+(10+i*gw+gw/2)+'" y="'+(H-3)+'" text-anchor="middle">'+mLabel(m)+'</text>'});
  return o+'</svg></div>';
}

function render(){
  const inc=sum(tx,'income'),exp=sum(tx,'expense'),bal=inc-exp;
  $('bal').textContent=fmt(bal);$('bal').className=bal<0?'ex':'';
  $('inc').textContent=fmt(inc);$('exp').textContent=fmt(exp);$('cnt').textContent=tx.length;
  // chart 1
  $('c1').innerHTML=tx.length?hbars([{l:'Income',v:inc,c:'var(--in)'},{l:'Expenses',v:exp,c:'var(--ex)'}],Math.max(inc,exp)):empty('Add your first income or expense to see this chart.');
  // chart 2
  const ec={};tx.filter(x=>x.type==='expense').forEach(x=>ec[x.cat]=(ec[x.cat]||0)+x.amt);
  const cl=Object.entries(ec).sort((a,b)=>b[1]-a[1]);
  $('c2').innerHTML=cl.length?hbars(cl.map(([l,v],i)=>({l,v,c:COL[i%COL.length],p:Math.round(v/exp*1000)/10})),cl[0][1]):empty('No expenses yet. Add an expense to see where your money goes.');
  // chart 3 & 4
  const ms=[...new Set(tx.map(x=>x.date.slice(0,7)))].sort();
  if(ms.length){
    const mi=ms.map(m=>sum(tx.filter(x=>x.date.startsWith(m)),'income')),me=ms.map(m=>sum(tx.filter(x=>x.date.startsWith(m)),'expense'));
    $('c3').innerHTML='<div class="lg"><span><i style="background:var(--in)"></i>Income</span><span><i style="background:var(--ex)"></i>Expenses</span></div>'+vchart(ms,[{d:mi,c:'var(--in)'},{d:me,c:'var(--ex)'}],false);
    $('c4').innerHTML=vchart(ms,[{d:mi.map((v,i)=>v-me[i]),cf:v=>v>=0?'var(--sv)':'var(--ex)'}],true)+'<div class="lg" style="margin-top:6px">'+ms.map((m,i)=>'<span>'+mLabel(m)+': '+fmt(mi[i]-me[i])+'</span>').join('')+'</div>';
  }else{$('c3').innerHTML=empty('Monthly totals will appear once you add transactions.');$('c4').innerHTML=empty('Savings are calculated from your income and expenses.')}
  // history
  const f=$('flt').value,list=tx.filter(x=>f==='all'||x.type===f).sort((a,b)=>b.date.localeCompare(a.date)||b.id.localeCompare(a.id));
  $('hist').innerHTML=list.length?list.map(x=>'<div class="tx"><div><b>'+esc(x.desc)+'</b><small>'+esc(x.cat)+' · '+x.date.split('-').reverse().join('/')+' · '+(x.type==='income'?'Income':'Expense')+'</small></div><div class="r"><b class="'+(x.type==='income'?'in':'ex')+'">'+(x.type==='income'?'+':'−')+fmt(x.amt)+'</b><div class="a"><button class="ghost" data-a="e" data-id="'+x.id+'">Edit</button><button class="ghost" data-a="d" data-id="'+x.id+'">Delete</button></div></div></div>').join(''):empty(tx.length?'No transactions match this filter.':'No transactions yet. Your history will appear here once you add one.');
}
load();resetForm();render();
</script></body></html>
